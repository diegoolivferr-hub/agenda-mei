# Configurações do Servidor Back-End
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Conexão com o Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agenda_mei
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# URL de Conexão Alternativa (opcional, substitui os campos acima se informada)
DATABASE_URL=postgresql://postgres:sua_senha_aqui@localhost:5432/agenda_mei

# Autenticação e Criptografia
JWT_SECRET=coloque_uma_chave_secreta_longa_e_aleatoria_aqui
JWT_EXPIRES_IN=7d
SALT_ROUNDS=10

# Front-End (Vite)
VITE_API_URL=http://localhost:3001/api
